LOTUS_IMAGE=filecoin/lotus-all-in-one:v1.38.3-2k
# Curio rejects chain nodes whose network name does not start with local or test.
NETWORK_NAME=localnet
FOREST_DATA_DIR=/forest_data
LOTUS_DATA_DIR=/lotus_data
FIL_PROOFS_PARAMETER_CACHE=/var/tmp/filecoin-proof-parameters
MINER_ACTOR_ADDRESS=t01000
MINER_BACKEND=curio
LOTUS_RPC_PORT=1234
LOTUS_P2P_PORT=1235
# Unused here; compose interpolates the extended forest-miner file which references it.
MINER_RPC_PORT=2345
FOREST_RPC_PORT=3456
FOREST_P2P_PORT=4903
CURIO_COMMIT=v1.29.0
CURIO_REPO_PATH=/var/lib/curio
YUGABYTE_IMAGE=yugabytedb/yugabyte:2025.2.2.2-b11@sha256:1fdda2ae928facf0b7b25b7c1183c540567c33730cce10a557c81c33a8e18422
